# ============================================================
# final-agent 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# --- DeepSeek V4 Pro ---
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 图片识别 (火山方舟 Doubao) ---
ARK_API_KEY=your-ark-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- 嵌入模型 (HuggingFace) ---
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# --- 重排序模型 ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- 向量库 ---
CHROMA_PERSIST_DIR=data/vector_db

# --- 分块参数 ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- 检索参数 ---
RETRIEVAL_TOP_K=10
RETRIEVAL_SIMILARITY_THRESHOLD=0.5
RETRIEVAL_MIN_MATCHES=3

# --- 生成参数 ---
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
